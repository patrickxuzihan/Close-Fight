# Normalize line endings
* text=auto

# Code and data
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf

# Unity YAML (force-text serialization)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf

# Binary art and audio (move to Git LFS once large assets arrive)
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.ogg binary
*.mp3 binary
*.fbx binary
